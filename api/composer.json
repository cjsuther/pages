{
    "name": "rezonar/personal-pages-api",
    "description": "API backend para sistema de páginas personales con notificaciones",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "minishlink/web-push": "^8.0",
        "phpmailer/phpmailer": "^6.9",
        "endroid/qr-code": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "classmap": [
            "Database.php",
            "JWT.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/crear-config.php"
        ],
        "test": "phpunit",
        "test:coverage": "@php -d pcov.enabled=1 -d pcov.directory=. ./vendor/bin/phpunit --coverage-text",
        "test:coverage-html": "@php -d pcov.enabled=1 -d pcov.directory=. ./vendor/bin/phpunit --coverage-html coverage"
    }
}
