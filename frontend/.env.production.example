# URL de la API para producción
# Esta variable se usa en el index.php para hacer las peticiones al backend
# Ejemplos:
# API_URL=https://api.tudominio.com
# API_URL=https://tudominio.com/api
# Si no se define, usará el mismo dominio donde esté alojado el frontend

# Opcional: Definir en el servidor con Apache
# En el archivo .htaccess o en la configuración del VirtualHost:
# SetEnv API_URL "https://api.tudominio.com"
